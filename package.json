{
  "name": "teyvat-build-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:data": "node scripts/sync-data.mjs && node scripts/sync-enka.mjs",
    "sync:enka": "node scripts/sync-enka.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,css,json,md,html}": "prettier --write"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "vite": "^5.4.11"
  }
}
